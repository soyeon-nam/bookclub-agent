{
  "schema_version": 1,
  "scope": "Book-club evaluation contracts; not a product quality verdict",
  "population": {
    "scored": "active AI participant utterances",
    "context": "active participant, user and moderator turns in original order",
    "excluded": "discarded turns; user and moderator turns are not scored as participants",
    "missing": "unavailable or failed measurements are null, not zero; conditional denominators must be reported"
  },
  "constraints": [
    {
      "id": "RM-1",
      "rule": "Do not treat safe convergence or agreement as discussion quality."
    },
    {
      "id": "RM-2",
      "rule": "Generation labels are plans, not independent quality annotations."
    },
    {
      "id": "RM-3",
      "rule": "Test surface-signal gaming and adversarial examples before quality claims."
    },
    {
      "id": "RM-4",
      "rule": "Use user turns as context, never score the user; exempt user-induced topic shifts."
    }
  ],
  "requirements": [
    {
      "id": "R1.1",
      "name": "해석 프레임 복수성",
      "unit": "session",
      "failure_modes": [
        "FM-11"
      ],
      "criterion": "세션에 실제 표출된 서로 다른 해석 프레임; 단어 다양성으로 대체하지 않는다."
    },
    {
      "id": "R1.2",
      "name": "동일 장면의 관점별 해석",
      "unit": "exchange",
      "failure_modes": [
        "FM-2",
        "FM-11"
      ],
      "criterion": "같은 장면을 서로 다른 관점으로 읽는 교환; 다른 장면의 병렬 언급은 제외한다."
    },
    {
      "id": "R2.1",
      "name": "책의 구체 내용 지시",
      "unit": "utterance",
      "failure_modes": [
        "FM-1"
      ],
      "criterion": "해석적 주장에 적용; 질문·진행·짧은 반응은 조건부 분모에서 제외한다."
    },
    {
      "id": "R2.2",
      "name": "장면의 분석적 사용",
      "unit": "utterance",
      "failure_modes": [
        "FM-2"
      ],
      "criterion": "장면이 주장을 뒷받침하는 설명에 사용되어야 한다."
    },
    {
      "id": "R2.3",
      "name": "원문 사실 충실",
      "unit": "utterance",
      "failure_modes": [
        "FM-4"
      ],
      "criterion": "원문과 사실 주장을 대조한다. 검색 구절에 없는 사실은 확인되지 않은 상태로 둔다."
    },
    {
      "id": "R3.2",
      "name": "책과 외부 지식 양쪽의 연결",
      "unit": "utterance",
      "failure_modes": [
        "FM-3"
      ],
      "criterion": "외부 지식이 등장할 때만 적용; 책→세계와 세계→책 모두 인정한다."
    },
    {
      "id": "R3.3",
      "name": "외부 지식에서 책으로 복귀",
      "unit": "utterance",
      "failure_modes": [
        "FM-3"
      ],
      "criterion": "책을 도입부로만 사용한 뒤 강의로 끝나는 경우를 구분한다."
    },
    {
      "id": "R4.1",
      "name": "상대 주장의 내용적 소화",
      "unit": "utterance",
      "failure_modes": [
        "FM-6"
      ],
      "criterion": "타인에게 반응하는 발화만 분모로 삼는다. 이름 언급이나 인사말은 소화의 증거가 아니다."
    },
    {
      "id": "R4.2",
      "name": "근거에 의한 입장 발전",
      "unit": "session",
      "failure_modes": [
        "FM-12"
      ],
      "criterion": "전후 입장과 변화 근거를 인용할 수 있어야 한다. 자기신고 수정 라벨만으로 충족되지 않는다."
    },
    {
      "id": "R4.3",
      "name": "생산적 불일치",
      "unit": "exchange",
      "failure_modes": [
        "FM-5"
      ],
      "criterion": "불일치가 나타났을 때 근거로 다루는지 본다. 반박 빈도를 최대화하는 목표는 아니다."
    },
    {
      "id": "R4.4",
      "name": "질문에 대한 내용적 반응",
      "unit": "exchange",
      "failure_modes": [
        "FM-7"
      ],
      "criterion": "답변 또는 공동 탐구를 인정한다. 열린 결말과 무반응을 구분한다."
    },
    {
      "id": "R4.5",
